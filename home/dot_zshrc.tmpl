# --- PATH -------------------------------------------------------------
typeset -U path PATH
path=(
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  "$HOME/Library/pnpm"
  "$HOME/.yarn/bin"
  "$HOME/.opencode/bin"
  "$HOME/.moss/bin"
  $path
)
export PATH

export PNPM_HOME="$HOME/Library/pnpm"

# --- Environment & shell options --------------------------------------
export EDITOR='nvim'           # default editor (git commit, etc.)
setopt AUTO_CD                 # a bare directory path cd's into it

# --- History ----------------------------------------------------------
# Sane defaults oh-my-zsh used to set silently; now explicit (frameless zsh).
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS INC_APPEND_HISTORY EXTENDED_HISTORY

# --- Completion -------------------------------------------------------
# Rebuild + security-audit the completion dump at most once a day; otherwise
# load the cached dump and skip the audit. Auditing Homebrew's hundreds of
# site-functions on every login shell is the single biggest startup cost.
autoload -Uz compinit
() {
  local -a dump=( "${ZDOTDIR:-$HOME}/.zcompdump"(Nmh+24) )
  if (( $#dump )); then compinit; else compinit -C; fi
}
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive

# --- Plugins (sheldon) ------------------------------------------------
# zsh-autosuggestions, fast-syntax-highlighting, and the oh-my-zsh git aliases —
# declared in ~/.config/sheldon/plugins.toml, cloned by `sheldon lock`.
# Runs after compinit so the git plugin's compdef calls resolve.
command -v sheldon >/dev/null && eval "$(sheldon source)"

# --- Tool integrations ------------------------------------------------
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd j)"   # `j <dir>`, as autojump did
command -v fzf    >/dev/null && source <(fzf --zsh)

# --- App integrations -------------------------------------------------
# GUI / dev-tool shell hooks and PATH entries, each existence-guarded so the
# line is inert on machines where the tool isn't installed. Generic and
# shareable, so they live here rather than in the private ~/.zshrc.local.
[[ -f "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"   # OrbStack
[[ -f "$HOME/.config/kaku/zsh/kaku.zsh" ]] && source "$HOME/.config/kaku/zsh/kaku.zsh" # Kaku Shell Integration
[[ -d "/Applications/Obsidian.app/Contents/MacOS" ]] && path+=("/Applications/Obsidian.app/Contents/MacOS")  # Obsidian CLI
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && path=("$HOME/.antigravity/antigravity/bin" $path)           # Antigravity (Google AI IDE)

# --- Runtimes (mise) --------------------------------------------------
command -v mise >/dev/null && eval "$(mise activate zsh)"

# --- Prompt -----------------------------------------------------------
command -v starship >/dev/null && eval "$(starship init zsh)"

# --- Aliases ----------------------------------------------------------
alias ls="eza"
alias ll="eza -l --git --icons"
alias la="eza -la --git --icons"
alias v="nvim"
alias zshconfig="${EDITOR:-nvim} ~/.zshrc"
alias cm="chezmoi"
alias pcm='chezmoi --config "$HOME/.config/chezmoi-private/chezmoi.yaml"'  # private dotfiles source (Binlogo/Dotfiles-Private); 'cmp' is taken by the byte-compare tool

# Claude Code: compact at 40% of 1M context; pair with model=opusplan + fastMode=true
alias c='CLAUDE_CODE_AUTO_COMPACT_WINDOW=400000 claude --dangerously-skip-permissions'

# Open the current dir in an external tool. While an agent holds the pane, open
# a cmux split (cmd+d) and run one of these there. For an agent's last change,
# `cmux diff --last-turn` is usually faster than leaving cmux at all.
alias f='open -a Fork "$PWD"'   # Fork — git history / diff
alias cur='cursor .'            # Cursor
alias z='zed .'                 # Zed   (z is free; zoxide is bound to `j`)

# --- Completions ------------------------------------------------------
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# --- Functions --------------------------------------------------------
# Create a git worktree + open it in a new cmux workspace
# Directory suffix uses periodic table symbols (h, he, li, ...) in order,
# reusing freed slots so paths stay stable for remote builds / agent memory.
function wt() {
  local branch=$1
  local repo_dir project parent_dir
  repo_dir=$(git rev-parse --show-toplevel) || return 1
  project=$(basename "$repo_dir")
  parent_dir="${repo_dir%/*}"

  local -a _elements=(
    h he li be b c n o f ne
    na mg al si p s cl ar k ca
    sc ti v cr mn fe co ni cu zn
    ga ge as se br kr rb sr y zr
    nb mo tc ru rh pd ag cd in sn
    sb te i xe cs ba la ce pr nd
    pm sm eu gd tb dy ho er tm yb
    lu hf ta w re os ir pt au hg
    tl pb bi po at rn fr ra ac th
    pa u np pu am cm bk cf es fm
    md no lr rf db sg bh hs mt ds
    rg cn nh fl mc lv ts og
  )

  local worktree_path _elem
  for _elem in "${_elements[@]}"; do
    local _candidate="${parent_dir}/${project}-${_elem}"
    if [[ ! -e "$_candidate" ]]; then
      worktree_path="$_candidate"
      break
    fi
  done
  if [[ -z "$worktree_path" ]]; then
    echo "wt: all 118 element slots are in use"; return 1
  fi

  git worktree add -b "$branch" "$worktree_path" || return 1
  for _f in "$worktree_path/mise.toml" "$worktree_path/.mise.toml"; do
    [[ -f "$_f" ]] && mise trust "$_f" 2>/dev/null
  done
  local ws
  ws=$(cmux new-workspace --name "${project}/${branch}" --cwd "$worktree_path" 2>&1 | awk '{print $2}')
  cmux select-workspace --workspace "$ws"
  echo "wt: for detach/attach (mobile, crash-proof), run \`tw\` here → session: ${branch//[^a-zA-Z0-9_-]/-}"
}

# Remove current worktree, its branch, and close its cmux workspace
function wtrm() {
  local worktree_path main_path branch ws
  worktree_path=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "wtrm: not in a git repo"; return 1; }
  main_path=$(git worktree list --porcelain | awk 'NR==1{print $2}')
  if [[ "$worktree_path" == "$main_path" ]]; then
    echo "wtrm: cannot remove the main worktree"; return 1
  fi
  branch=$(git rev-parse --abbrev-ref HEAD)
  ws=$(cmux current-workspace)

  # Safety checks
  local warnings=()
  local dirty
  dirty=$(git -C "$worktree_path" status --porcelain 2>/dev/null)
  [[ -n "$dirty" ]] && warnings+=("worktree has uncommitted changes")
  if ! git -C "$main_path" merge-base --is-ancestor "$branch" HEAD 2>/dev/null; then
    warnings+=("branch '${branch}' has unmerged commits")
  fi

  local force=false
  if (( ${#warnings[@]} > 0 )); then
    echo "wtrm: warning:"
    for w in "${warnings[@]}"; do echo "  - $w"; done
    echo -n "Force remove anyway? [y/N] "
    read -r confirm
    [[ "$confirm" != [yY] ]] && return 1
    force=true
  fi

  cmux select-workspace --workspace workspace:1
  if $force; then
    git -C "$main_path" worktree remove --force "$worktree_path"
    git -C "$main_path" branch -D "$branch"
  else
    git -C "$main_path" worktree remove "$worktree_path"
    git -C "$main_path" branch -d "$branch"
  fi
  cmux close-workspace --workspace "$ws"
  # Tear down this worktree's tmux session too, if `tw` ever created one.
  tmux kill-session -t "${branch//[^a-zA-Z0-9_-]/-}" 2>/dev/null
}

# Worktree tmux: start/attach a detachable session named after the current
# branch, so a long or agent task can survive detach / a cmux crash and be
# re-attached from another device:  mosh <host> -- tmux attach -t <name>
# cmux stays the daily driver — reach for this only when a task must outlive the
# front-end. `wt` prints the name on creation; `wtrm` cleans the session up.
function _wt_tmux_name() {
  local b; b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 1
  printf '%s' "${b//[^a-zA-Z0-9_-]/-}"
}
function tw() {
  local name; name=$(_wt_tmux_name) || { echo "tw: not in a git repo"; return 1; }
  tmux new-session -A -s "$name"
}

# --- Local overrides (never committed) --------------------------------
# Put machine-specific env, tokens, or work-only settings in ~/.zshrc.local
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# >>> otty shell integration >>>
# Added by Otty — toggle in Settings > Shell > Shell Integration.
# Inert unless launched by Otty (it sets $OTTY_SHELL_INTEGRATION).
if [ -n "$OTTY_SHELL_INTEGRATION" ] && [ -r "$OTTY_SHELL_INTEGRATION/otty-integration.zsh" ]; then
  . "$OTTY_SHELL_INTEGRATION/otty-integration.zsh"
fi
# <<< otty shell integration <<<

# Kaku appends this PATH line to ~/.zshrc itself (like Otty above); mirrored here
# verbatim so chezmoi and Kaku agree instead of fighting over the file.
[[ ":$PATH:" != *":$HOME/.config/kaku/zsh/bin:"* ]] && export PATH="$HOME/.config/kaku/zsh/bin:$PATH" # Kaku PATH Integration
