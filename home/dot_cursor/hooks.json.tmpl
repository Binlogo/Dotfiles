{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/inject-agents-md.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/cursor-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
        "timeout": 10
      }
    ],
